{
  "name": "stiborek-web-tools",
  "private": true,
  "description": "Nástroje pro build a testování webu Řeznictví Stiborek a syn. Na hosting se nenahrávají.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/build.mjs --check",
    "serve": "node tools/serve.mjs 8080",
    "test": "node tools/test-site.mjs",
    "screenshots": "node tools/screenshots.mjs http://localhost:8080/ screenshots",
    "zip": "python3 tools/make-zip.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "axe-core": "4.11.0",
    "html-validate": "9.7.1",
    "playwright": "1.56.1"
  }
}
